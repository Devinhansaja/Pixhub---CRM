# Copy to .env.local and fill in from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY — never prefix with NEXT_PUBLIC_. Used for inviting team members and the WhatsApp webhook.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the deployed app (used in invite emails and webhook URL display)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email campaigns: option A, any mailbox via SMTP (e.g. Gmail) ---------
# Gmail: turn on 2-Step Verification, create an App Password (myaccount.google.com/apppasswords)
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_DAILY_LIMIT=300   # max emails/day over all campaigns (Gmail default 300)
# EMAIL_PROVIDER=smtp    # force smtp|resend when both are configured

# --- Email campaigns: option B, Resend -----------------------------------
RESEND_API_KEY=
# Signing secret of the Resend webhook (whsec_…) → delivery, bounce, spam tracking
RESEND_WEBHOOK_SECRET=
# Long random string; the Supabase scheduler (supabase/email-cron.sql) sends it
CRON_SECRET=
# Optional: force the sender address (must be on your verified Resend domain)
# EMAIL_FROM_ADDRESS=hello@pixhub.lk

# --- Phase 3 (all optional; features stay off until set) ---------------

# AI Sales Assistant (server only) — https://platform.claude.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_HOURLY_LIMIT=60

# WhatsApp Business Platform (Cloud API) — Meta for Developers → your app → WhatsApp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string
# WHATSAPP_GRAPH_VERSION=v23.0
# WHATSAPP_HOURLY_LIMIT=30
